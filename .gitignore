# Obsidian local/device-specific state — don't sync across machines
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json
.trash/

# Local-only PDF backups — never pushed to GitHub (see chat: kept off the public repo intentionally)
/PDF Backups (local only)/

# Editor-local config, not vault content
.vscode/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Python bytecode cache, regenerated whenever a Scripts/ generator runs
__pycache__/
*.pyc
